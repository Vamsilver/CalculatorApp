<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="CalculatorForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="CalculatorCalculations.cs;CalculatorInteractions.cs;CalculatorLayout.cs;CalculatorModes.cs;CalculatorOverlays.cs;CalculatorTheme.cs">
      <DependentUpon>CalculatorForm.cs</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
</Project>
